# Realtime sync (optional). Set these BEFORE `pnpm run build` / `pnpm run deploy`
# — PUBLIC_* vars are baked into the client bundle at build time.
#
# After deploying the realtime Worker (`pnpm run deploy:realtime`), copy its
# https URL here as a wss:// URL. Leave unset to run without realtime (the app
# falls back to a faster poll).
#
# Local dev with `wrangler dev` on the realtime Worker:
#   PUBLIC_SYNC_URL=ws://localhost:8787

PUBLIC_SYNC_URL=
# Optional shared token — must match SYNC_TOKEN [vars] in workers/realtime/wrangler.toml.
PUBLIC_SYNC_TOKEN=
