---
import '@/styles/global.css';

interface Props {
  title: string;
  bg?: string;
}
const { title, bg = '#EFEBE4' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body style={`background:${bg}`}>
    <slot />
  </body>
</html>
